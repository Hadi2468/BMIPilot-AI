# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Required --------------------------------------------------------
OPENAI_API_KEY=
# Exercise database (https://api-ninjas.com). Without it the agent still runs and
# falls back to generic safe activities, with a warning in the report.
NINJAS_API_KEY=

# --- Optional: LangSmith tracing -------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bmipilot-ai

# --- App settings (defaults shown) -----------------------------------
BMIPILOT_OPENAI_MODEL=gpt-4o-mini
BMIPILOT_TEMPERATURE=0.2
BMIPILOT_MAX_EXERCISES=5

# API auth: when set, requests need "Authorization: Bearer <token>"
BMIPILOT_API_TOKEN=
# Where the Streamlit dashboard finds the API
BMIPILOT_API_URL=http://localhost:8000
